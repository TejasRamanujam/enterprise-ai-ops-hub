# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_workflow
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/ai_workflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://:redis@localhost:6379/0
REDIS_PASSWORD=redis

# ─── Vector DB ───────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333

# ─── Security ────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-secure-32-character-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── AI / LLM ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
DEFAULT_LLM_MODEL=claude-sonnet-4-6
EMBEDDING_MODEL=text-embedding-3-small

# ─── Jira ────────────────────────────────────────────────────────────────────
JIRA_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=PROJ

# ─── GitHub ──────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...
GITHUB_ORG=your-org
GITHUB_REPO=your-repo

# ─── Confluence ──────────────────────────────────────────────────────────────
CONFLUENCE_URL=https://yourcompany.atlassian.net
CONFLUENCE_EMAIL=your-email@company.com
CONFLUENCE_API_TOKEN=your-confluence-api-token
CONFLUENCE_SPACE_KEY=SPACE

# ─── Slack ───────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
SLACK_CHANNEL_ID=C0123456789

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ─── Environment ─────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ─── Frontend ────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api/v1
